# ── Required ─────────────────────────────────────────────────────────────
# Twitter / X API v2 Bearer Token (from https://developer.x.com)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Target Telegram Channel Username or ID (e.g. @your_channel or -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel_username

# Twitter/X Username to monitor (without @)
TWITTER_USERNAME=your_twitter_username

# ── Optional ─────────────────────────────────────────────────────────────
# Hashtag filter: only sync tweets containing this hashtag (e.g., SYNC_HASHTAG=SyncToTelegram).
# Leave empty (SYNC_HASHTAG=) to sync ALL tweets.
SYNC_HASHTAG=

# Number of days to check for deleted tweets to remove from Telegram (default: 7)
DELETE_CHECK_DAYS=7

# HTTP request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30
